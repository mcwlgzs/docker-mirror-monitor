# =============================================================================
# Docker 镜像加速服务监控 - 环境变量示例
#
# 用法：cp .env.example .env 后按需修改，docker compose 会自动读取同目录的 .env。
# 所有变量都有合理默认值，不创建 .env 也能直接启动。
# =============================================================================

# ---- 基础 ----
# 对外访问端口（宿主机）
DMM_HTTP_PORT=8080
# 时区，非法值会被 lib.php 自动回退到 Asia/Shanghai
TZ=Asia/Shanghai

# ---- 探测 ----
# 单个镜像源的探测总超时（秒）。全部源并发执行，整体耗时约等于最慢的那个。
DMM_PROBE_TIMEOUT=8
# 建立连接超时（秒）
DMM_PROBE_CONNECT_TIMEOUT=5
# 探测请求使用的 User-Agent
# DMM_PROBE_UA=Docker-Mirror-Monitor/2.0
# CA 证书包路径，留空自动探测（Alpine/Debian 镜像无需设置）
# DMM_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# 仅在排查「是证书问题还是镜像问题」时临时开启，正式环境切勿打开
# DMM_INSECURE_TLS=0

# ---- 缓存与日志 ----
# 探测结果缓存时长（秒）。越大越省探测开销，但状态更新越滞后。
DMM_CACHE_DURATION=300
# 访问日志保留天数，0 表示不清理
DMM_LOG_RETENTION_DAYS=7
# DMM_LOG_ENABLED=1

# ---- 速率限制（按客户端 IP）----
DMM_RATE_LIMIT_MAX=60
DMM_RATE_LIMIT_WINDOW=60
# 触发限流后的封禁时长（秒）
DMM_RATE_LIMIT_BLOCK=120

# ---- 反向代理 ----
# nginx 容器在前面终结连接，置 1 才会信任 X-Forwarded-For，取到真实客户端 IP
DMM_TRUST_PROXY=1
# 仅在直接暴露 api.php（前面没有可信代理）时才应该设为 0，
# 否则访客可以伪造 X-Forwarded-For 绕过限流。

# ---- 站点信息 ----
# DMM_APP_NAME=Docker 镜像加速服务监控
# 部署到公网时填写，用于页面 canonical / og:url
# DMM_SITE_URL=https://mirror.example.com
# 允许跨域访问 API 的来源，逗号分隔；同源部署留空即可
# DMM_CORS_ORIGINS=https://example.com,https://www.example.com
# 输出详细错误信息，仅调试期开启
# DMM_DEBUG=1

# ---- 阈值（毫秒）----
# 决定页面上「快速 / 一般 / 缓慢 / 极慢」的分档
DMM_THRESHOLD_FAST=500
DMM_THRESHOLD_FAIR=1000
DMM_THRESHOLD_SLOW=2000

# ---- quick_check 探测数量 ----
# 首屏快速出结果时只探测前 N 个源
DMM_QUICK_LIMIT=6

# ---- 容器网络 ----
# 探测需要解析外部域名；部分自建 DNS 环境会导致解析失败，可按需覆盖
DMM_DNS_1=223.5.5.5
DMM_DNS_2=119.29.29.29

# ---- 自定义监控列表 ----
# 用 JSON 覆盖内置的 11 个镜像源（数组，字段见 config.php 中的 services）
# 云厂商的专属加速器（如阿里云 https://<你的编码>.mirror.aliyuncs.com）只对同一
# 云账号/同云内网生效，不写进默认列表，部署在对应云上时用这里加进来。
# DMM_SERVICES_JSON=[{"id":"my","name":"自建镜像","url":"https://mirror.example.com","provider":"自建","description":"","region":"public","note":""}]
